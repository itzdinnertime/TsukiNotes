# Copy this file to .env (git ignores .env, so your passwords are never committed).
# Both docker compose and the API read it:
#   - docker compose uses it to create the database user the first time the database starts
#   - the API uses it to log in to that database
#
# Use your own password. If your database already exists, these must match the
# user and password it was first created with (changing them here doesn't change the database).

DB_USERNAME=tsukinote_user
DB_PASSWORD=change-me
